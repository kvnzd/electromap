{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "maquinasVirtuales/backend.Dockerfile",
    "watchPatterns": ["src/backend/**", "src/database/**", "maquinasVirtuales/backend.Dockerfile", ".dockerignore"]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}