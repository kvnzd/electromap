# Variables para docker compose (ElectroMap local con Docker).
# Copiar como ".env" en la RAÍZ del proyecto. Ese .env NUNCA se sube a GitHub (.gitignore).

# Clave para firmar las sesiones (mínimo 32 caracteres). Generarla con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=pegar-aqui-la-clave-generada

# Contraseña de la base PostgreSQL local de Docker (solo existe en tu PC).
POSTGRES_PASSWORD=electromap_local
