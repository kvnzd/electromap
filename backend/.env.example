# Plantilla de configuración. Copiar este archivo como ".env" y completar.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Railway -> servicio Postgres -> Variables -> DATABASE_PUBLIC_URL
DATABASE_URL=postgresql://usuario:password@host:puerto/railway

# Clave secreta para firmar los tokens de sesión (JWT). Generarla con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=pegar-aqui-la-clave-generada

# Minutos que dura una sesión antes de tener que volver a iniciar sesión
JWT_EXPIRA_MINUTOS=480

# Base de datos SOLO para pruebas automáticas (pytest). NUNCA la misma que DATABASE_URL.
# Railway -> servicio Postgres de pruebas -> Variables -> DATABASE_PUBLIC_URL
TEST_DATABASE_URL=postgresql://usuario:password@host:puerto/railway

# (Opcional) Direcciones del frontend autorizadas (CORS), en formato JSON.
# Por defecto: ["http://localhost:5173", "http://127.0.0.1:5173"]
# CORS_ORIGENES=["http://localhost:5173"]
